# ---------- Database ----------
# Empty = local SQLite at SQLITE_PATH (zero setup). Set a Postgres/Supabase URL for production.
DATABASE_URL=
SQLITE_PATH=data/egp-radar.db

# ---------- AI (optional) ----------
# Enables Claude news classification + the AI analyst. Without it the platform uses transparent rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# ---------- Alerts (optional) ----------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---------- Security ----------
# Required to call /api/cron/collect (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=change-me-long-random
# If set, saving settings requires this token
ADMIN_TOKEN=

# ---------- Collector ----------
BANK_POLL_SECONDS=300
# Identify yourself to the sites you poll
COLLECTOR_USER_AGENT=EGP-Radar/1.0 (+personal research; contact: you@example.com)
FRED_API_KEY=
